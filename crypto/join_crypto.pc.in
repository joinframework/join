prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: join_crypto
Description: Join C++ library - Cryptographic utilities
Version: @JOIN_VERSION@
Requires: join_core
Libs: -L${libdir} -ljoin_crypto
Cflags: -I${includedir}
